{
  "name": "@dynamic-solutions-canada/web-app-kit",
  "version": "0.1.0",
  "description": "Shared React and Joy UI primitives for Dynamic Solutions web apps.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dynamic-Solutions-Canada/web-app-kit.git"
  },
  "engines": {
    "node": ">=22.22.2 <25"
  },
  "packageManager": "npm@11.19.1",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:react18": "node scripts/test-react18.mjs"
  },
  "//": [
    "React 18 is tested by test:react18, which swaps React in place for one run; the peer range narrows to ^19 once every consumer has upgraded."
  ],
  "peerDependencies": {
    "@mui/joy": "^5.0.0-beta.52",
    "eslint": "^9.24.0 || ^10",
    "react": "^18.3.1 || ^19",
    "react-dom": "^18.3.1 || ^19"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/joy": "5.0.0-beta.52",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
